generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Doctor {
  id               String              @id @default(uuid())
  firstName        String
  lastName         String
  specialty        String
  phone            String
  email            String?
  status           String
  username         String?             @unique
  password         String?
  clinicId         String
  telegramChatId   String?
  percentage       Float               @default(0)
  salaryType       String              @default("none") // 'none' | 'fixed' | 'fixed_kpi' | 'kpi'
  fixedSalary      Float               @default(0)
  color            String?
  secondaryPhone   String?
  startHour        Int?
  endHour          Int?
  /// Kabinet raqami — talonda va navbat tablosida ko'rsatiladi. Migratsiya 0004.
  room             String?
  /// Haftaning ish kunlari: «1,2,3,4,5» (1 = dushanba). NULL — belgilanmagan.
  /// Migratsiya 0036.
  workDays         String?
  /// Qaysi bo'limda ishlaydi. `specialty` ko'rsatish uchun qoladi,
  /// filtr va hisobot esa shu maydon bo'yicha ishlaydi.
  departmentId     String?
  department       Department?         @relation(fields: [departmentId], references: [id])
  appointments     Appointment[]
  visits           Visit[]
  clinic           Clinic              @relation(fields: [clinicId], references: [id])
  installmentPlans InstallmentPlan[]
  patients         Patient[]
  expenses         Expense[]
  serviceRates     DoctorServiceRate[]
  payrollLines     PayrollLine[]

  @@unique([clinicId, telegramChatId])
}

model Receptionist {
  id           String      @id @default(uuid())
  firstName    String
  lastName     String
  phone        String
  username     String      @unique
  password     String
  status       String
  clinicId     String
  /// Umumiy xodim maydonlari (migratsiya 0035): to'rt rolda ham bir xil
  departmentId String?
  room         String?
  startHour    Int?
  endHour      Int?
  /// Xodimlar moduli (migratsiya 0036). Foiz ATAYLAB yo'q: ulush faqat
  /// shifokorda hisoblanadi, qolgan rollarda u hech qachon pul chiqarmaydi.
  specialty    String?
  email        String?
  fixedSalary  Float       @default(0)
  workDays     String?
  clinic       Clinic      @relation(fields: [clinicId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  expenses     Expense[]

  @@index([departmentId])
}

model Patient {
  id               String             @id @default(uuid())
  firstName        String
  lastName         String
  phone            String
  dob              String
  lastVisit        String
  status           String
  gender           String
  medicalHistory   String
  clinicId         String
  telegramChatId   String?
  address          String?
  createdAt        DateTime           @default(now())
  secondaryPhone   String?
  avatarUrl        String?
  portraitUrl      String?
  balance          Float              @default(0)
  doctorId         String?
  pinfl            String?
  /// Registratura aytadigan/yozadigan raqam. UUID bemor uchun yaroqsiz.
  /// Migratsiya 0003. Nullable: mavjud bemorlarda bo'sh.
  cardNumber       String?
  appointments     Appointment[]
  installmentPlans InstallmentPlan[]
  /// ESKI jurnal — 0028 dan keyin unga yozilmaydi, faqat tarix uchun turibdi
  inventoryLogs    InventoryLog[]
  stockMovements   StockMovement[]
  clinic           Clinic             @relation(fields: [clinicId], references: [id])
  doctor           Doctor?            @relation(fields: [doctorId], references: [id])
  diagnoses        PatientDiagnosis[]
  photos           PatientPhoto[]
  telegramLogs     TelegramLog[]
  transactions     Transaction[]
  visits           Visit[]
  labOrders        LabOrder[]
  studies          DiagnosticStudy[]
  admissions       Admission[]
  prescriptions    Prescription[]
  charges          VisitCharge[]
  allergies        PatientAllergy[]
  referrals        Referral[]
  vitals           VitalSign[]
  documents        PatientDocument[]
  accessLogs       AccessLog[]

  @@unique([clinicId, telegramChatId])
  /// Karta raqami klinika ichida takrorlanmaydi. SQLite da UNIQUE indeksda
  /// bir nechta NULL ruxsat etiladi, shuning uchun bo'sh qiymatlar to'siq emas.
  @@unique([clinicId, cardNumber])
  @@index([phone])
  /// Migratsiya 0029. Kirishdagi ro'yxat `createdAt DESC LIMIT 500` bilan
  /// o'qiydi — indekssiz saralash uchun vaqtinchalik B-daraxt qurilardi.
  @@index([clinicId, createdAt])
}

model PatientPhoto {
  id          String   @id @default(uuid())
  patientId   String
  url         String
  description String?
  category    String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  patient     Patient  @relation(fields: [patientId], references: [id])
}

model Appointment {
  id           String      @id @default(uuid())
  patientId    String
  patientName  String
  doctorId     String
  doctorName   String
  type         String
  date         String
  time         String
  duration     Int
  status       String
  notes        String?
  clinicId     String
  departmentId String?
  /// Qaysi xizmatga yozilgan. `type` — o'sha paytdagi NOM (snimok), bu esa
  /// bog'lam: nom o'zgarsa ham bemor kelganda xizmat topiladi.
  /// Migratsiya 0034.
  serviceId    Int?
  reminderSent Boolean     @default(false)
  service      Service?    @relation(fields: [serviceId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  clinic       Clinic      @relation(fields: [clinicId], references: [id])
  doctor       Doctor      @relation(fields: [doctorId], references: [id])
  patient      Patient     @relation(fields: [patientId], references: [id])
  review       Review?
  visits       Visit[]

  // @@unique([patientId, date]) OLIB TASHLANDI — migratsiya 0002.
  // Ko'p profilli klinikada bemor bir kunda bir necha shifokorga boradi:
  // ertalab terapevt, tushdan keyin UZI. Cheklov buni imkonsiz qilardi.
  // Dublikatdan himoya endi kodda: POST /api/appointments bir xil kunga
  // tushgan yozuvni topsa, izohlarni birlashtiradi (server.ts).
  @@index([date])
  @@index([patientId])
  /// Migratsiya 0029. `clinicId` bo'yicha indeks yo'q edi: shifokor kesimidagi
  /// so'rov butun jadvalni sana indeksi bo'ylab skan qilardi.
  @@index([clinicId, date])
  @@index([doctorId])
  @@index([serviceId])
}

/// Qabul — butun tizimning markaziy tuguni. Har bir modul (tahlil, diagnostika,
/// retsept, muolaja) shu yozuvga `visitId` orqali ulanadi va narxi bitta
/// Transaction oqimiga tushadi.
model Visit {
  id            String               @id @default(uuid())
  patientId     String
  appointmentId String?
  date          String
  checkInTime   DateTime             @default(now())
  checkOutTime  DateTime?
  status        String               @default("Waiting")
  complaints    String?
  vitalSigns    String?
  notes         String?
  clinicId      String
  departmentId  String?
  doctorId      String?
  doctorName    String?
  templateId    String?
  /// Kunlik navbat raqami — registratura qabulni ochganda beriladi
  queueNumber   Int?
  /// Navbat chaqirilgan vaqt — tablo va kutish vaqti uchun
  calledAt      DateTime?
  /// Natija kutilmoqda: qabul navbatdan chiqadi, lekin yopilmaydi
  awaitingSince DateTime?
  /// Registratura yoki shifokor: qaysi bosqichda turibdi
  /// Waiting | In Progress | Completed | Cancelled
  /// Bo'lim shabloni bo'yicha to'ldirilgan ko'rik maydonlari (JSON).
  /// Tish kartasining o'rnini shu egallaydi.
  examData      String?
  diagnosis     String?
  treatmentPlan String?
  /// Qabul nima bilan tugadi: Home | Followup | Admit | Referred. Migratsiya 0010.
  disposition   String?
  /// Yakunlangan bayon qulflanadi — keyin jimgina qayta yozib bo'lmaydi
  lockedAt      DateTime?
  lockedByName  String?
  /// DMED (IT-MED) ga yuborish holati. Xato matni ham saqlanadi:
  /// "yuborilmadi" bilan "PINFL bo'sh" bir xil emas. Migratsiya 0027.
  dmedId        String?
  dmedSyncedAt  DateTime?
  dmedError     String?
  diagnoses     PatientDiagnosis[]
  transactions  Transaction[]
  procedures    TreatmentProcedure[]
  labOrders     LabOrder[]
  studies       DiagnosticStudy[]
  prescriptions Prescription[]
  charges       VisitCharge[]
  referrals     Referral[]
  vitals        VitalSign[]
  documents     PatientDocument[]
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id])
  clinic        Clinic               @relation(fields: [clinicId], references: [id])
  patient       Patient              @relation(fields: [patientId], references: [id])
  department    Department?          @relation(fields: [departmentId], references: [id])
  doctor        Doctor?              @relation(fields: [doctorId], references: [id])
  template      EncounterTemplate?   @relation(fields: [templateId], references: [id])

  @@index([patientId])
  @@index([date])
  @@index([departmentId])
}

/// Bajarilgan xizmat. Ilgari stomatologik muolaja edi (toothNumber/toothSurface),
/// endi har qanday bo'lim xizmatini yozadi.
model TreatmentProcedure {
  id            String    @id @default(uuid())
  visitId       String
  procedureName String
  serviceId     Int?
  departmentId  String?
  status        String    @default("Planned")
  basePrice     Float
  discount      Float     @default(0)
  finalPrice    Float
  materialsUsed String?
  notes         String?
  duration      Int?
  doctorId      String
  doctorName    String
  /// Muolajada ikkinchi kishi — ulushi shifokordan boshqa. Migratsiya 0023.
  assistantId   String?
  assistantName String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?
  visit         Visit     @relation(fields: [visitId], references: [id])

  @@index([visitId])
  @@index([departmentId])
}

model Transaction {
  id              String          @id @default(uuid())
  patientName     String
  date            String
  amount          Float
  type            String
  service         String
  status          String
  clinicId        String
  doctorId        String?
  doctorName      String?
  patientId       String?
  visitId         String?
  discountAmount  Float?          @default(0)
  discountPercent Float?          @default(0)
  createdAt       DateTime?       @default(now())
  /// Pulni kim qabul qildi. Rollar har xil jadvalda (Receptionist/Doctor/Clinic admin)
  /// bo'lgani uchun FK emas — id va ism nusxasi saqlanadi.
  receivedById    String?
  receivedByName  String?
  clinic          Clinic          @relation(fields: [clinicId], references: [id])
  patient         Patient?        @relation(fields: [patientId], references: [id])
  visit           Visit?          @relation(fields: [visitId], references: [id])
  chargePayments  ChargePayment[]

  /// Migratsiya 0029. Bu jadvalda ilgari BIRONTA indeks yo'q edi, holbuki u
  /// eng katta jadval (10.1 o'lchovi: 110 010 qator) va kassa, bosh sahifa,
  /// hisobotlar hammasi undan o'qiydi.
  @@index([clinicId, date])
  @@index([patientId])
  @@index([doctorId])
  @@index([visitId])
}

model Expense {
  id              String               @id @default(uuid())
  date            String
  amount          Float
  category        String
  title           String
  method          String?
  note            String?
  clinicId        String
  doctorId        String?
  receptionistId  String?
  labOrderId      String?              @unique
  inventoryItemId String?
  /// Xarajat qaysi bo'limga tegishli. NULL — umumiy xarajat, hisobotda
  /// alohida qatorda ko'rinadi. Migratsiya 0022.
  departmentId    String?
  createdAt       DateTime             @default(now())
  clinic          Clinic               @relation(fields: [clinicId], references: [id])
  doctor          Doctor?              @relation(fields: [doctorId], references: [id])
  receptionist    Receptionist?        @relation(fields: [receptionistId], references: [id])
  labOrder        LabOrder?            @relation(fields: [labOrderId], references: [id])
  department      Department?          @relation(fields: [departmentId], references: [id])
  payrollLines    PayrollLine[]
  salaryPayments  StaffSalaryPayment[]

  @@index([clinicId])
  @@index([doctorId])
  @@index([receptionistId])
  @@index([departmentId])
}

model Service {
  id           Int                 @id @default(autoincrement())
  name         String
  price        Float
  duration     Int
  clinicId     String
  cost         Float               @default(0)
  categoryId   String?
  departmentId String?
  category     ServiceCategory?    @relation(fields: [categoryId], references: [id])
  department   Department?         @relation(fields: [departmentId], references: [id])
  clinic       Clinic              @relation(fields: [clinicId], references: [id])
  recipe       ServiceRecipe[]
  charges      VisitCharge[]
  rates        DoctorServiceRate[]
  appointments Appointment[]
}

/// O'LIK MEROS — obuna tarifi. Ilova darajasida BUTUNLAY olib tashlangan:
/// endpointlari yo'q (`GET/PUT /api/plans` o'chirilgan), interfeysda ko'rinmaydi,
/// shifokor soni chegarasi ham shu bilan ketdi.
///
/// Nima uchun jadval BAZADA qoldi. `Clinic.planId` — majburiy tashqi kalit.
/// Uni yo'qotish uchun `Clinic` jadvalini QAYTA QURISH kerak (SQLite da ustun
/// turini/nullability'ni o'zgartirishning boshqa yo'li yo'q), bu esa
/// `migrations/README.md` da ataylab taqiqlangan — aynan 11.1-B rad etilgan
/// sabab bilan bir xil: ishlayotgan klinika bazasida 20+ jadvalni qayta qurish
/// narxi foydasidan yuqori.
///
/// Ya'ni bu yerda bitta o'qilmaydigan qator turibdi. Unga hech kim yozmaydi.
model SubscriptionPlan {
  id         String   @id
  name       String
  price      Float
  maxDoctors Int
  features   String
  clinics    Clinic[]
}

model Clinic {
  id                      String                     @id @default(uuid())
  name                    String
  adminName               String
  username                String                     @unique
  password                String?
  phone                   String
  status                  String
  planId                  String
  subscriptionStartDate   String
  expiryDate              String
  monthlyRevenue          Float
  telegramChatId          String?
  botToken                String?
  /// Aktivatsiya kaliti. Mashina identifikatoridan hisoblanadi, shuning
  /// uchun baza boshqa kompyuterga ko'chirilsa kalit yaroqsiz bo'ladi.
  /// Migratsiya 0032.
  licenseKey              String?
  subscriptionType        String                     @default("Paid")
  smsBalance              Float                      @default(0)
  smsLimit                Int                        @default(0)
  smsUsedThisMonth        Int                        @default(0)
  ownerPhone              String?
  facebookPageAccessToken String?
  facebookPageId          String?
  facebookPageName        String?
  facebookUserAccessToken String?
  customPrice             Float?
  endHour                 Int                        @default(20)
  startHour               Int                        @default(8)
  address                 String?
  email                   String?
  enableReceipts          Boolean                    @default(false)
  notificationMode        String                     @default("telegram_only")
  eskizEmail              String?
  eskizPassword           String?
  eskizToken              String?
  eskizTokenExpiry        DateTime?
  eskizNick               String?
  dmedEnabled             Boolean                    @default(false)
  dmedApiKey              String?
  dmedApiSecret           String?
  dmedClinicId            String?
  dmedToken               String?
  dmedTokenExpiry         DateTime?
  prepaymentEnabled       Boolean                    @default(false)
  prepaymentCardNumber    String?
  prepaymentAmount        Float?
  accessControl           String?
  /// Tashqi lid manbalari (yuboraman va h.k.) uchun kirish kaliti.
  /// POST /api/public/leads da X-API-Key sarlavhasi orqali klinika shu kalit bo'yicha topiladi.
  leadApiKey              String?                    @unique
  leadApiKeyCreatedAt     DateTime?
  /// Bosma blank uchun: litsenziya raqami va blank pastidagi erkin satr.
  /// Migratsiya 0013.
  licenseNumber           String?
  letterheadNote          String?
  appointments            Appointment[]
  plan                    SubscriptionPlan           @relation(fields: [planId], references: [id])
  doctors                 Doctor[]
  installmentPlans        InstallmentPlan[]
  inventoryItems          InventoryItem[]
  leads                   Lead[]
  patients                Patient[]
  diagnoses               PatientDiagnosis[]
  receptionists           Receptionist[]
  services                Service[]
  serviceCategories       ServiceCategory[]
  telegramLogs            TelegramLog[]
  transactions            Transaction[]
  visits                  Visit[]
  salesAgentId            String?
  salesAgent              SalesAgent?                @relation(fields: [salesAgentId], references: [id])
  labTechnicians          LabTechnician[]
  nurses                  Nurse[]
  referrals               Referral[]
  doctorRates             DoctorServiceRate[]
  payrollRuns             PayrollRun[]
  staffAdjustments        StaffAdjustment[]
  staffAttendance         StaffAttendance[]
  staffSalaryPayments     StaffSalaryPayment[]
  documents               PatientDocument[]
  accessLogs              AccessLog[]
  administrations         MedicationAdministration[]
  vitals                  VitalSign[]
  labOrders               LabOrder[]
  expenses                Expense[]
  messageTemplates        MessageTemplate[]
  automationRules         AutomationRule[]
  cashRegisterDays        CashRegisterDay[]
  cashMovements           CashMovement[]
  cashAuditLogs           CashAuditLog[]
  /// Kuniga nechta kassa smenasi (1 yoki 2). Klinikaga qarab sozlanadi.
  cashShiftsPerDay        Int                        @default(1)
  departments             Department[]
  encounterTemplates      EncounterTemplate[]
  labTests                LabTest[]
  studies                 DiagnosticStudy[]
  wards                   Ward[]
  admissions              Admission[]
  prescriptions           Prescription[]
  charges                 VisitCharge[]
  stockMovements          StockMovement[]
  serviceRecipes          ServiceRecipe[]
  chargePayments          ChargePayment[]
  patientAllergies        PatientAllergy[]

  @@index([botToken])
}

/// Kassa smenasini yopish: sanalgan naqd/terminal/Click hisob bilan solishtiriladi.
/// Bir kunda bir nechta smena bo'lishi mumkin (klinika sozlamasiga qarab).
model CashRegisterDay {
  id            String    @id @default(uuid())
  clinicId      String
  date          String
  /// Smena raqami. Bitta smenali klinikada har doim 1.
  shift         Int       @default(1)
  shiftStart    String?
  shiftEnd      String?
  /// Smena boshidagi naqd qoldiq (oldingi yopilishdan ko'chib keladi)
  openingCash   Float     @default(0)
  /// Kassir haqiqatda sanagan naqd
  countedCash   Float
  /// Yopilgan daqiqadagi hisob bo'yicha naqd qoldiq (snapshot)
  expectedCash  Float
  /// countedCash − expectedCash (kam/ortiq)
  difference    Float     @default(0)
  /// Terminal Z-hisoboti bo'yicha summa (kiritilmasa null — solishtirilmaydi)
  countedCard   Float?
  expectedCard  Float?
  /// Click/Payme kabineti bo'yicha summa
  countedClick  Float?
  expectedClick Float?
  note          String?
  closedByName  String?
  closedByRole  String?
  closedAt      DateTime  @default(now())
  /// Smenani KIM ochgani. Ilgari faqat yopilish yozilardi. Migratsiya 0008.
  /// Qator bor-yo'qligi endi "yopilgan" degani emas: ochilgan smenada ham
  /// qator bo'ladi. Migratsiya 0012.
  isClosed      Boolean   @default(true)
  openedAt      DateTime?
  openedByName  String?
  openedByRole  String?
  clinic        Clinic    @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, date, shift])
  @@index([clinicId])
}

/// Kassaga xizmat to'lovidan tashqari kirgan/chiqqan pul.
/// Xarajatdan (Expense) ataylab ajratilgan: inkassatsiya va qaytarish klinikaning
/// xarajati emas, shuning uchun sof foydadan ayirilmasligi kerak.
model CashMovement {
  id            String   @id @default(uuid())
  clinicId      String
  date          String
  /// 'Encashment' — kassadan olib ketildi (inkassatsiya)
  /// 'Refund'     — bemorga pul qaytarildi
  /// 'CashIn'     — kassaga pul solindi (masalan, qaytim uchun mayda pul)
  type          String
  amount        Float
  /// Qaysi usulda: naqd yashikka faqat 'Cash' ta'sir qiladi
  method        String   @default("Cash")
  note          String?
  patientId     String?
  transactionId String?
  createdByName String?
  createdAt     DateTime @default(now())
  clinic        Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([date])
}

/// Kassa yozuvlariga qilingan o'zgarishlar izi.
/// Ayniqsa kun yopilgandan keyin to'lov o'chirilishi/o'zgartirilishi qayd etiladi —
/// bu kassa dasturidagi eng klassik teshik.
model CashAuditLog {
  id         String   @id @default(uuid())
  clinicId   String
  /// Yozuv qaysi kassa kuniga tegishli
  date       String
  action     String
  entityType String
  entityId   String?
  summary    String
  /// Kun o'sha paytda yopilgan bo'lganmi
  afterClose Boolean  @default(false)
  byName     String?
  byRole     String?
  createdAt  DateTime @default(now())
  clinic     Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([date])
}

model Lead {
  id        String   @id @default(uuid())
  name      String
  phone     String
  service   String?
  source    String?
  notes     String?
  /// Tashqi manbadan (yuboraman va h.k.) kelgan payload'ning asl nusxasi, JSON matn ko'rinishida.
  /// notes matnga aylantirilganda ma'lumot yo'qolishi mumkin — bu ustun zaxira sifatida saqlanadi.
  raw       String?
  /// Manzil va tug'ilgan sana lid bemorga aylantirilganda Patient'ga ko'chiriladi.
  address   String?
  dob       String?
  status    String   @default("New")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id])

  @@index([clinicId])
  @@index([status])
  @@index([clinicId, phone, createdAt])
}

model DemoRequest {
  id           String   @id @default(uuid())
  name         String
  clinicName   String?
  phone        String
  city         String?
  doctorsCount Int?
  source       String?
  status       String   @default("New")
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model PlatformSetting {
  key       String   @id
  value     String?
  updatedAt DateTime @default(now())
}

model ICD10Code {
  code        String             @id
  /// O'zbekcha nom — interfeysning asosiy tili
  name        String
  /// Ruscha nom. Migratsiya 0030: qidiruv ikkala tilda ham ishlashi kerak —
  /// shifokor "gipert" yozsa ham, "гиперт" yozsa ham topsin.
  nameRu      String?
  description String?
  category    String?
  diagnoses   PatientDiagnosis[]

  @@index([category])
}

model PatientDiagnosis {
  id        String    @id @default(uuid())
  patientId String
  code      String
  date      String
  notes     String?
  status    String
  clinicId  String
  visitId   String?
  /// Surunkali kasallik — bemor kartasida doimiy ro'yxatda turadi. Migratsiya 0011.
  isChronic Boolean   @default(false)
  clinic    Clinic    @relation(fields: [clinicId], references: [id])
  icd10     ICD10Code @relation(fields: [code], references: [code])
  patient   Patient   @relation(fields: [patientId], references: [id])
  visit     Visit?    @relation(fields: [visitId], references: [id])

  @@index([patientId, isChronic])
}

model InventoryItem {
  id                String             @id @default(uuid())
  name              String
  unit              String
  quantity          Float              @default(0)
  minQuantity       Float              @default(0)
  clinicId          String
  departmentId      String?
  /// Dori bo'lsa partiya va yaroqlilik muddati nazorat qilinadi
  isMedication      Boolean            @default(false)
  /// Xizmat ko'rsatilganda retsept bo'yicha avtomatik hisobdan chiqadi
  isConsumable      Boolean            @default(true)
  form              String?
  activeIngredient  String?
  price             Float              @default(0)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  clinic            Clinic             @relation(fields: [clinicId], references: [id])
  logs              InventoryLog[]
  batches           InventoryBatch[]
  prescriptionItems PrescriptionItem[]
  medicationOrders  MedicationOrder[]
  movements         StockMovement[]
  recipeLines       ServiceRecipe[]

  @@index([clinicId])
}

model InventoryLog {
  id        String        @id @default(uuid())
  itemId    String
  change    Float
  type      String
  note      String?
  date      DateTime      @default(now())
  userName  String
  patientId String?
  cost      Float?
  item      InventoryItem @relation(fields: [itemId], references: [id])
  patient   Patient?      @relation(fields: [patientId], references: [id])

  @@index([itemId])
  @@index([patientId])
}

model ServiceCategory {
  id       String    @id @default(uuid())
  name     String
  clinicId String
  services Service[]
  clinic   Clinic    @relation(fields: [clinicId], references: [id])

  @@unique([clinicId, name])
}

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  rating        Int
  comment       String?
  createdAt     DateTime    @default(now())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

model TelegramLog {
  id        String   @id @default(uuid())
  clinicId  String
  patientId String?
  type      String
  status    String
  message   String?
  error     String?
  sentAt    DateTime @default(now())
  channel   String   @default("telegram")
  source    String   @default("manual")
  ruleId    String?
  refId     String?
  recipient String?
  clinic    Clinic   @relation(fields: [clinicId], references: [id])
  patient   Patient? @relation(fields: [patientId], references: [id])

  @@index([clinicId])
  @@index([patientId])
  @@index([ruleId, refId])
}

model MessageTemplate {
  id               String           @id @default(uuid())
  clinicId         String
  name             String
  text             String
  eskizTemplateId  Int? // Eskiz.uz'dagi shablon ID'si
  eskizStatus      String? // Eskiz'dan qaytgan moderatsiya holati (masalan: moderation/confirmed/declined)
  eskizSubmittedAt DateTime? // Oxirgi marta Eskiz'ga yuborilgan vaqt
  createdAt        DateTime         @default(now())
  clinic           Clinic           @relation(fields: [clinicId], references: [id])
  rules            AutomationRule[]

  @@index([clinicId])
}

model AutomationRule {
  id          String          @id @default(uuid())
  clinicId    String
  name        String
  templateId  String
  trigger     String // 'before_appointment' | 'birthday' | 'no_show'
  hoursBefore Int?
  channel     String // 'sms' | 'telegram' | 'both'
  doctorId    String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  clinic      Clinic          @relation(fields: [clinicId], references: [id])
  template    MessageTemplate @relation(fields: [templateId], references: [id])

  @@index([clinicId])
}

model InstallmentPlan {
  id          String            @id @default(uuid())
  patientId   String
  clinicId    String
  doctorId    String?
  service     String
  totalAmount Float
  totalPaid   Float             @default(0)
  startDate   String
  endDate     String
  status      String            @default("Active")
  createdAt   DateTime          @default(now())
  items       InstallmentItem[]
  /// Reja qaysi qatorlar ustiga qurilgan (0033)
  charges     VisitCharge[]
  clinic      Clinic            @relation(fields: [clinicId], references: [id])
  doctor      Doctor?           @relation(fields: [doctorId], references: [id])
  patient     Patient           @relation(fields: [patientId], references: [id])
}

model InstallmentItem {
  id            String          @id @default(uuid())
  planId        String
  expectedDate  String
  amount        Float
  status        String          @default("Pending")
  paidDate      String?
  transactionId String?
  plan          InstallmentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
}

model SalesAgent {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  password  String
  phone     String
  status    String   @default("Active") // Active, Blocked
  clinics   Clinic[]
  createdAt DateTime @default(now())
}

model LabTechnician {
  id           String      @id @default(uuid())
  firstName    String
  lastName     String
  specialty    String
  phone        String
  status       String      @default("Active")
  clinicId     String
  username     String?     @unique
  password     String?
  /// Umumiy xodim maydonlari (migratsiya 0035)
  departmentId String?
  room         String?
  startHour    Int?
  endHour      Int?
  /// Xodimlar moduli (migratsiya 0036)
  email        String?
  fixedSalary  Float       @default(0)
  workDays     String?
  clinic       Clinic      @relation(fields: [clinicId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  labOrders    LabOrder[]

  @@index([clinicId])
  @@index([departmentId])
}

/// Tahlil yo'llanmasi. Ilgari stomatologik protez buyurtmasi edi
/// (orderType/material/toothNumbers) — endi laboratoriya tahlillari.
model LabOrder {
  id                String         @id @default(uuid())
  clinicId          String
  patientId         String?
  patientName       String
  visitId           String?
  doctorId          String?
  doctorName        String
  technicianId      String?
  technicianName    String?
  status            String         @default("Ordered")
  priority          String         @default("Normal")
  orderedAt         DateTime       @default(now())
  sampleCollectedAt DateTime?
  completedAt       DateTime?
  deadline          String?
  totalPrice        Float          @default(0)
  clinicianNotes    String?
  technicianNotes   String?
  /// Natija tayyor bo'lgach shifokor ko'rdimi. NULL = ko'rilmagan. Migratsiya 0009.
  seenByDoctorAt    DateTime?
  clinic            Clinic         @relation(fields: [clinicId], references: [id])
  patient           Patient?       @relation(fields: [patientId], references: [id])
  visit             Visit?         @relation(fields: [visitId], references: [id])
  technician        LabTechnician? @relation(fields: [technicianId], references: [id])
  items             LabOrderItem[]
  expense           Expense?

  @@index([clinicId])
  @@index([patientId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════
//  KO'P PROFILLI KLINIKA
// ═══════════════════════════════════════════════════════════════════════════

/// Bo'lim — ko'p profilli klinikani bir profillidan ajratadigan asosiy tushuncha.
/// `type` qaysi qabul shakli va qaysi UI ko'rsatilishini hal qiladi.
model Department {
  id        String   @id @default(uuid())
  clinicId  String
  name      String
  code      String
  /// CLINICAL | LAB | DIAGNOSTIC | INPATIENT | PHARMACY
  type      String   @default("CLINICAL")
  color     String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  clinic         Clinic              @relation(fields: [clinicId], references: [id])
  doctors        Doctor[]
  services       Service[]
  appointments   Appointment[]
  visits         Visit[]
  templates      EncounterTemplate[]
  labTests       LabTest[]
  studies        DiagnosticStudy[]
  wards          Ward[]
  admissions     Admission[]
  stockFrom      StockMovement[]     @relation("StockMovementFrom")
  stockTo        StockMovement[]     @relation("StockMovementTo")
  referrals      Referral[]
  nurses         Nurse[]
  /// Migratsiya 0035: bo'lim endi hamma xodim rolida bor
  receptionists  Receptionist[]
  labTechnicians LabTechnician[]
  expenses       Expense[]
  doctorRates    DoctorServiceRate[]
  transferFrom   AdmissionTransfer[] @relation("TransferFromDept")
  transferTo     AdmissionTransfer[] @relation("TransferToDept")

  @@unique([clinicId, code])
  @@index([clinicId])
}

/// Qabul bayoni shabloni. Tish kartasining o'rnini bosadi: har bo'lim o'z
/// maydonlar to'plamini oladi, ular JSON sifatida saqlanadi.
model EncounterTemplate {
  id           String   @id @default(uuid())
  clinicId     String
  departmentId String
  name         String
  /// [{ key, label, type: text|number|select|textarea|checkbox, unit?, options?, group? }]
  fields       String
  isDefault    Boolean  @default(false)
  /// Shablon kimga mos: 'Male' | 'Female' | null (hammaga). Migratsiya 0031.
  /// Erkak bemorda ginekologiya shabloni ochilib qolgan edi (audit B-09).
  gender       String?
  /// Yosh chegarasi, to'liq yil. null — chegara yo'q. Migratsiya 0031.
  minAge       Int?
  maxAge       Int?
  createdAt    DateTime @default(now())

  clinic     Clinic     @relation(fields: [clinicId], references: [id])
  department Department @relation(fields: [departmentId], references: [id])
  visits     Visit[]

  @@index([departmentId])
  @@index([gender])
}

// ─── Laboratoriya ──────────────────────────────────────────────────────────

model LabTest {
  id              String  @id @default(uuid())
  clinicId        String
  departmentId    String?
  name            String
  code            String
  /// Qon | Siydik | Najas | Surtma | Boshqa
  sampleType      String  @default("Qon")
  price           Float   @default(0)
  cost            Float   @default(0)
  turnaroundHours Int     @default(24)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  clinic     Clinic             @relation(fields: [clinicId], references: [id])
  department Department?        @relation(fields: [departmentId], references: [id])
  parameters LabTestParameter[]
  orderItems LabOrderItem[]

  @@unique([clinicId, code])
  @@index([clinicId])
}

/// Tahlil ko'rsatkichi va uning normasi. Norma jins/yoshga bog'liq bo'lgani uchun
/// bitta ko'rsatkich bir necha qatorda bo'lishi mumkin.
model LabTestParameter {
  id        String  @id @default(uuid())
  testId    String
  name      String
  unit      String?
  refLow    Float?
  refHigh   Float?
  refText   String?
  /// null = hammaga; "Male" | "Female"
  sex       String?
  ageMin    Int?
  ageMax    Int?
  sortOrder Int     @default(0)

  test    LabTest     @relation(fields: [testId], references: [id], onDelete: Cascade)
  results LabResult[]

  @@index([testId])
}

model LabOrderItem {
  id       String @id @default(uuid())
  orderId  String
  testId   String
  testName String
  price    Float  @default(0)
  status   String @default("Pending")

  order   LabOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  test    LabTest     @relation(fields: [testId], references: [id])
  results LabResult[]

  @@index([orderId])
}

/// Natija. `flag` saqlanadi, hisoblanmaydi — norma keyin o'zgarsa ham eski
/// natija o'sha paytdagi bahoni ko'rsatishi kerak.
model LabResult {
  id          String   @id @default(uuid())
  orderItemId String
  parameterId String
  value       String
  valueNum    Float?
  /// Normal | High | Low
  flag        String   @default("Normal")
  note        String?
  enteredBy   String?
  enteredAt   DateTime @default(now())

  orderItem LabOrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  parameter LabTestParameter @relation(fields: [parameterId], references: [id])

  @@index([orderItemId])
}

// ─── Diagnostika ───────────────────────────────────────────────────────────

/// UZI, EKG, rentgen va h.k. Laboratoriyadan farqi: natija raqam emas,
/// tavsif + xulosa + rasm.
model DiagnosticStudy {
  id              String    @id @default(uuid())
  clinicId        String
  patientId       String
  patientName     String
  visitId         String?
  departmentId    String?
  serviceId       Int?
  /// UZI | EKG | RENTGEN | ENDOSKOPIYA | MRT | KT
  modality        String
  name            String
  status          String    @default("Ordered")
  orderedById     String?
  orderedByName   String?
  performedById   String?
  performedByName String?
  orderedAt       DateTime  @default(now())
  performedAt     DateTime?
  findings        String?
  conclusion      String?
  price           Float     @default(0)
  /// Shifokor natijani ko'rdimi. Migratsiya 0009.
  seenByDoctorAt  DateTime?

  clinic     Clinic           @relation(fields: [clinicId], references: [id])
  patient    Patient          @relation(fields: [patientId], references: [id])
  visit      Visit?           @relation(fields: [visitId], references: [id])
  department Department?      @relation(fields: [departmentId], references: [id])
  files      DiagnosticFile[]

  @@index([clinicId])
  @@index([patientId])
  @@index([status])
}

model DiagnosticFile {
  id        String   @id @default(uuid())
  studyId   String
  url       String
  kind      String   @default("image")
  caption   String?
  createdAt DateTime @default(now())

  study DiagnosticStudy @relation(fields: [studyId], references: [id], onDelete: Cascade)

  @@index([studyId])
}

// ─── Statsionar ────────────────────────────────────────────────────────────

model Ward {
  id           String  @id @default(uuid())
  clinicId     String
  departmentId String?
  name         String
  floor        String?
  /// Umumiy | Yarim lyuks | Lyuks | Reanimatsiya
  kind         String  @default("Umumiy")
  dailyRate    Float   @default(0)
  isActive     Boolean @default(true)

  clinic     Clinic      @relation(fields: [clinicId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  beds       Bed[]

  @@index([clinicId])
}

model Bed {
  id     String @id @default(uuid())
  wardId String
  label  String
  /// Free | Occupied | Cleaning | Blocked
  status String @default("Free")

  ward         Ward                @relation(fields: [wardId], references: [id], onDelete: Cascade)
  admissions   Admission[]
  transferFrom AdmissionTransfer[] @relation("TransferFromBed")
  transferTo   AdmissionTransfer[] @relation("TransferToBed")

  @@index([wardId])
}

/// Yotqizish. Chiqarilgunicha ochiq turadi; koyka haqi har kuni hisoblanadi.
model Admission {
  id                 String    @id @default(uuid())
  clinicId           String
  patientId          String
  patientName        String
  departmentId       String?
  doctorId           String?
  doctorName         String?
  bedId              String?
  admittedAt         DateTime  @default(now())
  dischargedAt       DateTime?
  /// Active | Discharged
  status             String    @default("Active")
  reason             String?
  diagnosis          String?
  dischargeSummary   String?
  dailyRate          Float     @default(0)
  /// Oxirgi marta koyka haqi yozilgan sana (YYYY-MM-DD) — takroriy yozuvni oldini oladi
  lastChargedDate    String?
  totalCharges       Float     @default(0)
  /// Chiqarish epikrizining to'rt qismi. `dischargeSummary` eski yotishlar
  /// uchun joyida qoladi. Migratsiya 0019.
  admissionDiagnosis String?
  finalDiagnosis     String?
  treatmentGiven     String?
  recommendations    String?

  clinic           Clinic                     @relation(fields: [clinicId], references: [id])
  patient          Patient                    @relation(fields: [patientId], references: [id])
  department       Department?                @relation(fields: [departmentId], references: [id])
  bed              Bed?                       @relation(fields: [bedId], references: [id])
  rounds           InpatientRound[]
  medicationOrders MedicationOrder[]
  administrations  MedicationAdministration[]
  vitals           VitalSign[]
  transfers        AdmissionTransfer[]
  charges          VisitCharge[]

  @@index([clinicId])
  @@index([patientId])
  @@index([status])
}

model InpatientRound {
  id          String   @id @default(uuid())
  admissionId String
  date        String
  doctorId    String?
  doctorName  String?
  vitalSigns  String?
  notes       String?
  plan        String?
  createdAt   DateTime @default(now())

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([admissionId])
}

// ─── Dorixona ──────────────────────────────────────────────────────────────

/// Partiya va yaroqlilik muddati. Chiqim eng yaqin muddatlisidan boshlanadi (FEFO).
model InventoryBatch {
  id          String   @id @default(uuid())
  itemId      String
  batchNumber String?
  expiryDate  String?
  quantity    Float    @default(0)
  cost        Float    @default(0)
  receivedAt  DateTime @default(now())

  item      InventoryItem   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  movements StockMovement[]

  @@index([itemId])
  @@index([expiryDate])
}

model Prescription {
  id          String   @id @default(uuid())
  clinicId    String
  patientId   String
  patientName String
  visitId     String?
  doctorId    String?
  doctorName  String?
  date        String
  status      String   @default("Active")
  notes       String?
  createdAt   DateTime @default(now())

  clinic  Clinic             @relation(fields: [clinicId], references: [id])
  patient Patient            @relation(fields: [patientId], references: [id])
  visit   Visit?             @relation(fields: [visitId], references: [id])
  items   PrescriptionItem[]

  @@index([clinicId])
  @@index([patientId])
}

/// Dori omborda bo'lmasa ham retsept yozilishi kerak — shuning uchun
/// medicationId ixtiyoriy, nomi matn sifatida ham saqlanadi.
model PrescriptionItem {
  id             String  @id @default(uuid())
  prescriptionId String
  medicationId   String?
  name           String
  dosage         String?
  frequency      String?
  durationDays   Int?
  instructions   String?

  prescription Prescription   @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medication   InventoryItem? @relation(fields: [medicationId], references: [id])

  @@index([prescriptionId])
}

/// Statsionarda dori tayinlash
model MedicationOrder {
  id           String   @id @default(uuid())
  admissionId  String
  medicationId String?
  name         String
  dosage       String?
  route        String?
  frequency    String?
  startDate    String
  endDate      String?
  status       String   @default("Active")
  createdAt    DateTime @default(now())

  admission       Admission                  @relation(fields: [admissionId], references: [id], onDelete: Cascade)
  medication      InventoryItem?             @relation(fields: [medicationId], references: [id])
  administrations MedicationAdministration[]

  @@index([admissionId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  PUL: HISOB QATORI
// ═══════════════════════════════════════════════════════════════════════════

/// Hisob qatori — qo'ldagi qog'ozning o'rni.
///
/// Klinikada bemor har bir yo'llanma bilan kassaga boradi: konsultatsiya uchun
/// bir marta, tahlil uchun yana bir marta. Shuning uchun "to'landi" bayrog'i
/// qabulga emas, HAR BIR XIZMAT QATORIGA tegishli — bitta qabulda konsultatsiya
/// to'langan, tahlil to'lanmagan bo'lishi mumkin.
///
/// Qator har bir buyurtmada avtomatik yaratiladi: xizmat qo'shilganda, tahlilga
/// yuborilganda, tekshiruv buyurilganda.
model VisitCharge {
  id                String    @id @default(uuid())
  clinicId          String
  visitId           String?
  patientId         String?
  patientName       String
  /// Service | Lab | Study | Medication | Bed | Other
  source            String
  /// Manba yozuvining id si (TreatmentProcedure, LabOrder, DiagnosticStudy...)
  sourceId          String?
  name              String
  quantity          Float     @default(1)
  unitPrice         Float
  discount          Float     @default(0)
  total             Float
  /// Unpaid | Paid | Cancelled
  status            String    @default("Unpaid")
  /// Qisman to'lovni qo'llab-quvvatlaydi: total ga yetganda status Paid bo'ladi
  paidAmount        Float     @default(0)
  paidAt            DateTime?
  transactionId     String?
  createdAt         DateTime  @default(now())
  createdByName     String?
  /// Qator KIMNING ishi. Chekka emas, qatorga yoziladi: bitta chek bir necha
  /// shifokorning xizmatini o'z ichiga oladi. Migratsiya 0007.
  doctorId          String?
  doctorName        String?
  /// Statsionar yotishiga bog'lanish: koyka haqi va dorilarda qabul yo'q.
  /// Migratsiya 0015.
  admissionId       String?
  /// Xizmat katalogiga bog'lanish. Nom o'zgaradi, id o'zgarmaydi —
  /// hisobot va shifokor ulushi shunga tayanadi. Migratsiya 0021.
  serviceId         Int?
  /// Qator bo'lib to'lash rejasiga kiritilgan. Reja PULNI yozmaydi — u
  /// faqat jadval; to'lov shu qatorlar orqali o'tadi. Migratsiya 0033.
  installmentPlanId String?

  clinic          Clinic                     @relation(fields: [clinicId], references: [id])
  visit           Visit?                     @relation(fields: [visitId], references: [id])
  patient         Patient?                   @relation(fields: [patientId], references: [id])
  admission       Admission?                 @relation(fields: [admissionId], references: [id])
  service         Service?                   @relation(fields: [serviceId], references: [id])
  installmentPlan InstallmentPlan?           @relation(fields: [installmentPlanId], references: [id])
  payments        ChargePayment[]
  administrations MedicationAdministration[]

  @@index([clinicId, status])
  @@index([doctorId])
  @@index([visitId])
  @@index([patientId])
  @@index([sourceId])
  @@index([admissionId])
  @@index([serviceId])
  @@index([installmentPlanId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  OMBOR HARAKATLARI VA XIZMAT RETSEPTI
// ═══════════════════════════════════════════════════════════════════════════

/// Ombordagi HAR BIR o'zgarish shu jadvalga qator bo'lib tushadi.
///
/// Qoldiq hech qachon qo'lda tahrirlanmaydi — u shu qatorlarning yig'indisi.
/// Aks holda "kim oldi, qachon yo'qoldi" degan savolga javob bo'lmaydi.
model StockMovement {
  id               String   @id @default(uuid())
  clinicId         String
  itemId           String
  batchId          String?
  /// In | Out | Adjust | Writeoff
  type             String
  /// Musbat — kirim, manfiy — chiqim
  quantity         Float
  /// Purchase | Service | Expired | Damaged | Inventory | Manual | Legacy
  /// `Legacy` — 0028 da eski `InventoryLog` dan ko'chirilgan qatorlar.
  /// Ular xizmat tannarxiga qo'shilmaydi (reports.ts faqat `Service` ni sanaydi).
  reason           String   @default("Manual")
  visitId          String?
  serviceId        Int?
  note             String?
  userName         String?
  createdAt        DateTime @default(now())
  /// Bo'limlar orasida ko'chirish (type = 'Transfer'). Migratsiya 0005.
  fromDepartmentId String?
  toDepartmentId   String?
  /// Bemor kartasidan sarflangan material. Migratsiya 0028 — ilgari bu
  /// ma'lumot faqat eski `InventoryLog` da bor edi.
  patientId        String?
  /// Bekor qilingan chiqimning teskarisi. Harakat hech qachon o'chirilmaydi:
  /// uning o'rniga qarama-qarshi qator yoziladi va shu yerda bog'lanadi.
  reversalOfId     String?

  clinic         Clinic          @relation(fields: [clinicId], references: [id])
  item           InventoryItem   @relation(fields: [itemId], references: [id])
  batch          InventoryBatch? @relation(fields: [batchId], references: [id])
  patient        Patient?        @relation(fields: [patientId], references: [id])
  fromDepartment Department?     @relation("StockMovementFrom", fields: [fromDepartmentId], references: [id])
  toDepartment   Department?     @relation("StockMovementTo", fields: [toDepartmentId], references: [id])

  @@index([clinicId, createdAt])
  @@index([itemId])
  @@index([visitId])
  @@index([patientId])
  @@index([reversalOfId])
}

/// Xizmat retsepti (нормы списания / технологическая карта).
///
/// Bitta xizmatga qancha material ketishi shu yerda yoziladi. Xizmat bajarilgan
/// deb belgilanganda tizim materiallarni O'ZI ombordan chiqaradi va tannarxni
/// hisoblaydi. Bunsiz hech kim har shpritsni qo'lda yozmaydi va ombor
/// raqamlari yolg'on bo'lib qoladi.
model ServiceRecipe {
  id        String  @id @default(uuid())
  clinicId  String
  serviceId Int
  itemId    String
  quantity  Float
  note      String?

  clinic  Clinic        @relation(fields: [clinicId], references: [id])
  service Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  item    InventoryItem @relation(fields: [itemId], references: [id])

  @@unique([serviceId, itemId])
  @@index([clinicId])
}

// ═══════════════════════════════════════════════════════════════════════════
//  SXEMA VERSIYASI
// ═══════════════════════════════════════════════════════════════════════════

/// Qaysi migratsiya allaqachon qo'llanilgani.
///
/// Nima uchun kerak. Klinikaning kompyuterida Prisma CLI yo'q, ya'ni
/// `prisma db push` ni ishga tushirish imkoni yo'q. Yangi ustun yoki jadval
/// o'sha yerga qanday yetib borishini shu mexanizm hal qiladi: o'rnatuvchi
/// ichida raqamlangan SQL fayllar keladi, server ishga tushganda yetishmayotgan
/// migratsiyalarni qo'llaydi va shu jadvalga yozib qo'yadi.
///
/// Nima uchun Prisma sxemasida e'lon qilingan. Xizmat jadvalini Prisma'dan
/// yashirish jozibali edi, lekin ishlab chiqishda ishlatiladigan
/// `prisma db push` sxemada yo'q jadvalni "chetdan kelgan" deb hisoblaydi va
/// tozalab tashlashi mumkin. Besh qator e'lon shu xavfni olib tashlaydi.
/// Qatorlarni esa baribir raner raw SQL bilan boshqaradi, Prisma Client emas.
model SchemaMigration {
  /// Fayl nomi, masalan `0002_appointment_drop_unique`
  version    String   @id
  appliedAt  DateTime @default(now())
  /// SQL faylning xeshi: qo'llanilgandan keyin fayl tahrirlangani ko'rinadi
  checksum   String?
  /// Qancha vaqt ketgani — kuchsiz kompyuterda diagnostika uchun
  durationMs Int?
  /// `baseline` — ishlayotgan klinikaning boshlang'ich nuqtasi;
  /// xatolik bo'lsa — sabab matni
  note       String?
}

/// Hisob qatori va chek o'rtasidagi bog'lanish — KO'PDAN-KO'PGA.
///
/// Ilgari bog'lanish `VisitCharge.transactionId` orqali bitta edi, va shu
/// sababli to'rt narsa imkonsiz bo'lgan: bir chek bilan bir necha qatorni
/// to'lash, qisman to'lovda qatorni tanlash, chekni naqd+karta deb bo'lish,
/// bitta qator bo'yicha qaytarish.
///
/// `VisitCharge.paidAmount` yig'indi keshi bo'lib qoladi — ataylab ortiqchalik:
/// mavjud kod buzilmasligi kerak.
model ChargePayment {
  id            String   @id @default(uuid())
  clinicId      String
  chargeId      String
  transactionId String
  /// Shu chekdan shu qatorga qancha ketgani
  amount        Float
  /// Payment | Refund. Qaytarish manfiy summa bilan yoziladi.
  kind          String   @default("Payment")
  createdAt     DateTime @default(now())
  createdByName String?

  clinic      Clinic      @relation(fields: [clinicId], references: [id])
  charge      VisitCharge @relation(fields: [chargeId], references: [id])
  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([chargeId])
  @@index([transactionId])
  @@index([clinicId, createdAt])
}

/// Bemorning allergiyasi.
///
/// Ilgari allergiya qabul bayonining JSON matnida yotardi (`Visit.examData`),
/// ya'ni uni qidirib ham, ko'rsatib ham, dori tayinlaganda solishtirib ham
/// bo'lmasdi. Allergiya — bemor xavfsizligi masalasi, JSON ichidagi satr emas.
///
/// Olib tashlanganda yozuv O'CHIRILMAYDI, `isActive` o'chadi: tibbiy ma'lumot
/// tarixi saqlanishi kerak.
model PatientAllergy {
  id          String   @id @default(uuid())
  clinicId    String
  patientId   String
  /// Dori yoki modda
  substance   String
  /// Qanday namoyon bo'lgan
  reaction    String?
  /// Mild | Severe | Unknown
  severity    String   @default("Unknown")
  notedAt     DateTime @default(now())
  notedByName String?
  isActive    Boolean  @default(true)

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])

  @@index([patientId])
  @@index([clinicId])
}

/// ═══ RELIZ 4: statsionar va yo'llanma ═══════════════════════════════════════

/// YO'LLANMA — raqami va holati bor hujjat (migratsiya 0014).
/// Ilgari shifokor og'zida aytardi, bemor qo'lida qog'oz qolmasdi.
model Referral {
  id                 String   @id @default(uuid())
  clinicId           String
  patientId          String
  visitId            String?
  /// Qog'ozdagi raqam. Klinika ichida takrorlanmaydi.
  number             String
  /// Lab | Study | Consult | Cashier
  kind               String
  targetDepartmentId String?
  /// Issued | Used | Cancelled
  status             String   @default("Issued")
  issuedAt           DateTime @default(now())
  issuedByName       String?
  /// Berilgan paytdagi xizmatlar va summa (JSON). Narx keyin o'zgarsa ham
  /// bemor qo'lidagi qog'oz bilan tizim bir xil qolishi kerak.
  payload            String?

  clinic           Clinic      @relation(fields: [clinicId], references: [id])
  patient          Patient     @relation(fields: [patientId], references: [id])
  visit            Visit?      @relation(fields: [visitId], references: [id])
  targetDepartment Department? @relation(fields: [targetDepartmentId], references: [id])

  @@unique([clinicId, number])
  @@index([clinicId, status])
  @@index([patientId])
  @@index([visitId])
}

/// Dori BERILGANINING fakti (migratsiya 0016).
/// `MedicationOrder` — tayinlash, bu — bajarilish. Ilgari fakt hech qayerda
/// yozilmasdi: ombor dorini "bor" deb hisoblardi, hisobda ko'rinmasdi.
model MedicationAdministration {
  id          String   @id @default(uuid())
  clinicId    String
  orderId     String
  /// Bo'lim bo'yicha kunlik ro'yxat uchun to'g'ridan-to'g'ri kalit
  admissionId String
  givenAt     DateTime @default(now())
  givenByName String?
  dose        String?
  /// Given | Skipped | Refused — berilmagani ham fakt
  status      String   @default("Given")
  skipReason  String?
  chargeId    String?
  note        String?

  clinic    Clinic          @relation(fields: [clinicId], references: [id])
  order     MedicationOrder @relation(fields: [orderId], references: [id])
  admission Admission       @relation(fields: [admissionId], references: [id])
  charge    VisitCharge?    @relation(fields: [chargeId], references: [id])

  @@index([orderId])
  @@index([admissionId, givenAt])
  @@index([clinicId])
}

/// Harorat varag'i uchun o'lchovlar (migratsiya 0017).
/// Har o'lchov alohida qator: JSON dan grafik qurib bo'lmaydi.
model VitalSign {
  id             String   @id @default(uuid())
  clinicId       String
  patientId      String
  admissionId    String?
  visitId        String?
  measuredAt     DateTime @default(now())
  /// Temp | BpSys | BpDia | Pulse | Weight | Height | SpO2
  kind           String
  value          Float
  unit           String?
  measuredByName String?

  clinic    Clinic     @relation(fields: [clinicId], references: [id])
  patient   Patient    @relation(fields: [patientId], references: [id])
  admission Admission? @relation(fields: [admissionId], references: [id])
  visit     Visit?     @relation(fields: [visitId], references: [id])

  @@index([patientId, kind, measuredAt])
  @@index([admissionId])
  @@index([clinicId])
}

/// Bo'lim va koyka almashinuvi (migratsiya 0018).
/// Ilgari `Admission.bedId` ustiga yozilardi va tarix yo'qolardi.
model AdmissionTransfer {
  id               String   @id @default(uuid())
  admissionId      String
  fromBedId        String?
  toBedId          String?
  fromDepartmentId String?
  toDepartmentId   String?
  movedAt          DateTime @default(now())
  movedByName      String?
  reason           String?

  admission      Admission   @relation(fields: [admissionId], references: [id])
  fromBed        Bed?        @relation("TransferFromBed", fields: [fromBedId], references: [id])
  toBed          Bed?        @relation("TransferToBed", fields: [toBedId], references: [id])
  fromDepartment Department? @relation("TransferFromDept", fields: [fromDepartmentId], references: [id])
  toDepartment   Department? @relation("TransferToDept", fields: [toDepartmentId], references: [id])

  @@index([admissionId, movedAt])
}

/// HAMSHIRA (migratsiya 0020, qaror В17).
/// Dorini shifokor emas, hamshira beradi — jurnalda haqiqiy ijrochi turishi
/// kerak. Tuzilishi laborant qolipida: login, parol, rol tekshiruvi.
model Nurse {
  id           String   @id @default(uuid())
  firstName    String
  lastName     String
  phone        String?
  status       String   @default("Active")
  clinicId     String
  /// Kunlik dori ro'yxati "mening bo'limim" bo'yicha ochiladi
  departmentId String?
  username     String?  @unique
  password     String?
  createdAt    DateTime @default(now())
  /// Umumiy xodim maydonlari (migratsiya 0035)
  room         String?
  startHour    Int?
  endHour      Int?
  /// Palata, operatsiya, protsedura hamshirasi
  specialty    String?
  /// Xodimlar moduli (migratsiya 0036)
  email        String?
  fixedSalary  Float    @default(0)
  workDays     String?

  clinic     Clinic      @relation(fields: [clinicId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@index([clinicId])
  @@index([departmentId])
}

/// ═══ RELIZ 5: shifokor ulushi va vedomost ═══════════════════════════════════

/// Har XIZMATGA o'z foizi (migratsiya 0023).
/// `Doctor.percentage` — stavka topilmaganda ishlatiladigan qiymat, u joyida
/// qoladi. Ya'ni migratsiyadan keyin hisob-kitob o'zgarmaydi.
model DoctorServiceRate {
  id           String   @id @default(uuid())
  clinicId     String
  doctorId     String
  /// NULL — stavka butun bo'limga, ikkisi ham NULL — umumiy stavka
  serviceId    Int?
  departmentId String?
  percent      Float
  /// Doctor | Assistant — bitta muolajada ikki kishi ishlaydi
  role         String   @default("Doctor")
  createdAt    DateTime @default(now())

  clinic     Clinic      @relation(fields: [clinicId], references: [id])
  doctor     Doctor      @relation(fields: [doctorId], references: [id])
  service    Service?    @relation(fields: [serviceId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])

  @@unique([doctorId, serviceId, role])
  @@index([doctorId])
}

/// Oylik vedomosti (migratsiya 0024).
/// Draft holatida yaratiladi, tekshirilib tasdiqlanadi. Tasdiqlangandan keyin
/// QAYTA HISOBLANMAYDI: o'tgan oy bugungi stavka bilan o'zgarib ketmasligi kerak.
model PayrollRun {
  id             String    @id @default(uuid())
  clinicId       String
  periodFrom     String
  periodTo       String
  /// Draft | Approved | Paid
  status         String    @default("Draft")
  createdAt      DateTime  @default(now())
  createdByName  String?
  approvedByName String?
  approvedAt     DateTime?
  note           String?

  clinic Clinic        @relation(fields: [clinicId], references: [id])
  lines  PayrollLine[]

  @@index([clinicId, periodFrom])
}

model PayrollLine {
  id        String  @id @default(uuid())
  runId     String
  doctorId  String?
  /// Nom NUSXASI: xodim ketsa ham moliyaviy hujjatda ismi qoladi
  staffName String
  accrued   Float   @default(0)
  paid      Float   @default(0)
  expenseId String?
  /// Hisob qanday chiqqani (JSON): qaysi xizmatlar, qaysi foiz
  detail    String?

  run     PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  doctor  Doctor?    @relation(fields: [doctorId], references: [id])
  expense Expense?   @relation(fields: [expenseId], references: [id])

  @@index([runId])
}

/// ═══ RELIZ 6: huquqiy kontur ════════════════════════════════════════════════

/// Bemor imzolaydigan hujjat (migratsiya 0026).
///
/// `textSnapshot` — imzolangan paytdagi MATN. Shablon keyin o'zgaradi, hujjat
/// esa o'zgarmasligi kerak: bemor imzolagani aynan shu matn. Bu maydonsiz
/// hujjatning huquqiy kuchi yo'q.
/// ═══ XODIMLAR MODULI (migratsiya 0036) ══════════════════════════════════════

/// Bonus yoki jarima — bir xodimga, bir oyga.
///
/// `staffRole` + `staffId`: to'rtta xodim jadvaliga bitta tashqi kalit qo'yib
/// bo'lmaydi, shuning uchun bog'lam rol nomi bilan yuritiladi. Xodim
/// o'chirilmaydi — ro'yxatdan chiqariladi, ya'ni yozuv osilib qolmaydi.
model StaffAdjustment {
  id            String   @id @default(uuid())
  clinicId      String
  /// DOCTOR | RECEPTIONIST | LAB_TECHNICIAN | NURSE
  staffRole     String
  staffId       String
  /// Qaysi oyga tegishli: 'YYYY-MM'
  period        String
  /// Bonus | Penalty
  type          String
  reason        String
  amount        Float
  createdAt     DateTime @default(now())
  createdByName String?

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@index([clinicId, staffRole, staffId, period])
}

/// Xodim davomati: bir xodim, bir kun — bitta yozuv.
///
/// Oylikdan AVTOMATIK ushlanmaydi. Kelmagan kun uchun qancha ushlash —
/// direktorning qarori; dastur o'zi ushlasa, hech kim so'ramagan pul
/// ushlanib qoladi. Kelmagan kun ko'rinadi, ushlash esa jarima orqali
/// qo'lda yoziladi.
model StaffAttendance {
  id        String   @id @default(uuid())
  clinicId  String
  staffRole String
  staffId   String
  /// 'YYYY-MM-DD', Toshkent vaqti bo'yicha
  date      String
  /// Present | Absent | Excused | Late
  status    String
  note      String?
  createdAt DateTime @default(now())

  clinic Clinic @relation(fields: [clinicId], references: [id])

  @@unique([staffRole, staffId, date])
  @@index([clinicId, date])
}

/// Oylik to'lovi — ASOSIY maosh (+bonus −jarima).
///
/// Shifokorning ULUSHI bu yerga kirmaydi: u to'langan xizmatdan hisoblanadi
/// va vedomost (`PayrollRun`) orqali to'lanadi. Ikki yo'l ataylab ajratilgan —
/// aks holda bitta pul ikki marta berilishi mumkin edi. Xodim kartasi
/// ikkalasini yonma-yon ko'rsatadi.
///
/// Nusxa maydonlari (`staffName`, `base`, `bonus`, `penalty`) ataylab: to'lov
/// hujjat, va u keyin stavka o'zgarganda o'zgarmasligi kerak.
model StaffSalaryPayment {
  id         String   @id @default(uuid())
  clinicId   String
  staffRole  String
  staffId    String
  staffName  String
  period     String
  base       Float    @default(0)
  bonus      Float    @default(0)
  penalty    Float    @default(0)
  amount     Float
  method     String?
  expenseId  String?
  paidAt     DateTime @default(now())
  paidByName String?

  clinic  Clinic   @relation(fields: [clinicId], references: [id])
  expense Expense? @relation(fields: [expenseId], references: [id])

  @@unique([staffRole, staffId, period])
  @@index([clinicId, period])
}

model PatientDocument {
  id                String    @id @default(uuid())
  clinicId          String
  patientId         String
  visitId           String?
  /// Consent | Contract | DataConsent | Discharge | Other
  kind              String
  number            String?
  textSnapshot      String?
  signedAt          DateTime?
  signedByName      String?
  patientSigned     Boolean   @default(false)
  filePath          String?
  /// ERI maydonlari — Б9.5 uchun oldindan (jadvalni qayta yaratmaslik uchun)
  signature         String?
  signerCertificate String?
  createdAt         DateTime  @default(now())
  createdByName     String?

  clinic  Clinic  @relation(fields: [clinicId], references: [id])
  patient Patient @relation(fields: [patientId], references: [id])
  visit   Visit?  @relation(fields: [visitId], references: [id])

  @@index([patientId, kind])
  @@index([clinicId, createdAt])
}

/// Kim bemor kartasini ko'rgani va o'zgartirgani (migratsiya 0025).
///
/// Yozuvlar API orqali YARATILMAYDI: jurnalga tashqaridan yozish mumkin
/// bo'lsa, unga ishonch yo'q. Ularni tibbiy ma'lumot qaytaradigan
/// endpointlardagi server prosloykasi yozadi.
model AccessLog {
  id         String   @id @default(uuid())
  clinicId   String
  at         DateTime @default(now())
  userRole   String?
  userName   String?
  /// Tashqi kalit EMAS: rollar turli jadvallarda yotadi
  userId     String?
  /// View | Create | Update | Delete | Print | Export
  action     String
  /// Visit | LabOrder | DiagnosticStudy | PatientDocument | Patient ...
  entityType String
  entityId   String?
  patientId  String?

  clinic  Clinic   @relation(fields: [clinicId], references: [id])
  patient Patient? @relation(fields: [patientId], references: [id])

  @@index([clinicId, at])
  @@index([patientId, at])
  @@index([entityType, entityId])
}
