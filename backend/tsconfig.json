{
    "compilerOptions": {
        "target": "es2016",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        /* `..` — chunki `../shared/validation.ts` import qilinadi (S3.1).
           Bunsiz tsc rootDir ni o'zi hisoblab, chiqishni `dist/backend/`
           ga surib yuborardi va `start` yo'li buzilardi. Endi u ataylab
           belgilangan va `start` shunga moslangan.

           Relizga TA'SIR QILMAYDI: production `dist-bundle/index.js` dan
           yuriladi (ncc, `npm run bundle`), u esa import grafigini o'zi
           kuzatadi va `shared` ni ichiga qo'shib yuboradi. */
        "rootDir": ".."
    },
    "include": [
        "../shared/validation.ts",
        "server.ts",
        "multiprofile.ts",
        "billing.ts",
        "inventory.ts",
        "reports.ts",
        "botManager.ts",
        "smsService.ts",
        "triggers.ts",
        "segments.ts",
        "segmentFields.ts",
        "segmentAggregates.ts",
        "savedSegments.ts",
        "ruleExtras.ts",
        "bot.ts",
        "dmedService.ts",
        "aiService.ts",
        "ai/tools.ts",
        "ai/prompts.ts",
        "ai/reports.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "test_*.ts",
        "debug_*.ts",
        "check_*.ts"
    ]
}