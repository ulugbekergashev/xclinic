# ─────────────────────────────────────────────────────────────
# XClinic — offline backend sozlamalari
# Bu faylni `.env` deb nusxalang. Hech qachon git'ga qo'shmang.
# ─────────────────────────────────────────────────────────────

# BAZA: mahalliy SQLite. Electron ishga tushganda baza foydalanuvchining
# AppData papkasiga ko'chiriladi — denta7 ning Postgres bazasiga TEGILMAYDI.
DATABASE_URL="file:./xclinic.db"

# SERVER
PORT=3001

# JWT — o'rnatishda har bir mijoz uchun tasodifiy qiymat generatsiya qiling
JWT_SECRET="CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING"

# ─── ixtiyoriy integratsiyalar (offline'da bo'sh qoldirilsa ham ishlaydi) ───
# TELEGRAM_BOT_TOKEN=
# ESKIZ_MOCK_MODE=true
# AI_PROVIDER=
# GROQ_API_KEY=
# GEMINI_API_KEY=
