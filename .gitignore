node_modules/
dist/
dist-demo/
dist-electron/
dist-bundle/
electron-main/
build/*

# Muhit va sirlar
.env
.env.local
.env.*.local

# Baza — hech qachon repoga tushmaydi
*.db
*.db-journal
*.sqlite
backend/prisma/migrations/
backend/uploads/

# Log va vaqtinchalik fayllar
*.log
.DS_Store
Thumbs.db

# Arxivlar va tekshiruv fayllari
*.zip

# Vaqtinchalik ish fayllari (test tokenlari, id lar)
backend/_*
_*

# SQLite ning ish fayllari (WAL rejimi). `*.db` chetlab o'tilgan, lekin
# yonidagi `-wal` va `-shm` emas edi — ular baza bilan birga o'zgaradi
# va har kommitga tushib, tarixni ma'nosiz shovqinga to'ldirardi.
*.db-wal
*.db-shm

# Playwright sinovlarining chiqishi (suratlar, izlar)
test-results/
playwright-report/

# Dastur ikonkasi build artefakti EMAS — `electron-builder` uni shu yerdan
# oladi va fayl bo'lmasa standart Electron belgisini qo'yadi. Ya'ni u
# repozitoriyda bo'lishi shart, aks holda boshqa kompyuterda yig'ilgan
# o'rnatuvchi boshqa birovning logosi bilan chiqadi.
!build/icon.ico

# Cloudflare tunnel dasturi — 66 MB, Cloudflare ning ochiq vositasi.
# Repoga TUSHMAYDI: git tarixini shishiradi va uni har kim rasmiy
# saytdan olishi mumkin. O'rnatuvchiga esa qo'shiladi (`package.json`
# dagi `extraResources`) — README ga qarang.
resources/cloudflared.exe
